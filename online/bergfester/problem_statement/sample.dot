digraph RootedTree {
    node [shape=circle, style=filled, fillcolor=white];

    // Nodes
    1[label="1\n"];
    2[label="2\n"];
    3 [label="3\nP:1"];
    4 [label="4\nP:3"];
    5;
    6 [label="6\nP:2"];
    7;

    // Edges (child -> parent)
    3 -> 2;
    4 -> 2;
    2 -> 1;
    6 -> 5;
    7 -> 5;
    5 -> 1;
}
